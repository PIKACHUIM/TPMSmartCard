{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tpmsmartcard.local/schema/delivery.schema.json",
  "title": "CertificateDelivery",
  "description": "外部 CA 平台（OpenCertRepo）向证书下发 Worker 推送的交付请求",
  "type": "object",
  "required": ["mode", "target", "payload"],
  "additionalProperties": false,
  "properties": {
    "mode": { "enum": ["key", "code"] },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pubkey": { "type": "string", "minLength": 32, "maxLength": 88 },
        "code": { "type": "string", "minLength": 8, "maxLength": 32 }
      },
      "oneOf": [
        { "required": ["pubkey"] },
        { "required": ["code"] }
      ]
    },
    "payload": {
      "type": "object",
      "required": ["cert_pem"],
      "properties": {
        "cert_pem": { "type": "string", "minLength": 32 },
        "key_pem": { "type": "string" },
        "chain_pem": { "type": "string" },
        "pfx_base64": { "type": "string" },
        "algorithm": { "type": "string" },
        "serial_number": { "type": "string" },
        "common_name": { "type": "string" },
        "not_before": { "type": "string", "format": "date-time" },
        "not_after": { "type": "string", "format": "date-time" },
        "revoked": { "type": "boolean" },
        "sans": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ttl": { "type": "integer", "minimum": 0, "maximum": 7776000 },
    "max_uses": { "type": "integer", "minimum": 1, "maximum": 100 },
    "label": { "type": "string", "maxLength": 128 }
  }
}
