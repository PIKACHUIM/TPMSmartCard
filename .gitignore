build/
build/*
Caches/
Caches/*
# 打包中间产物与产物（install.iss / 工作流生成）
dist/
staging/
# 覆盖全局 gitignore 里的 *.msi（UGit 自动生成的规则）：
# OpenSC 安装包需要随仓库分发，否则 CI 里打包/安装都会缺文件
!OpenSC/*.msi
__pycache__
.idea
# FIDO2 设备端/服务端运行时日志（调试时产生）
Fido/src/*.log
Fido/*.log
# 文档站（VitePress）：依赖、构建缓存与产物都不入库；CNAME 由 CI 按需生成
node_modules/
docs/.vitepress/cache/
docs/.vitepress/dist/
docs/public/CNAME
# 智能体工作区数据（不随代码分发）
.workbuddy/
# 工具链临时目录（YAML 校验等）
._yamlcheck/
