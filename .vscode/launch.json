{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Desktop (Wails)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/desktop/wails",
      "buildFlags": "-tags=desktop,production",
      "cwd": "${workspaceFolder}/desktop/wails",
      "preLaunchTask": "desktop: prepare",
      "console": "internalConsole"
    },
    {
      "name": "Core API (serve :1026)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/core/cmd/tpmsc",
      "args": ["serve", "-addr", "127.0.0.1:1026"],
      "cwd": "${workspaceFolder}/core",
      "console": "integratedTerminal"
    },
    {
      "name": "CLI (doctor)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/core/cmd/tpmsc",
      "args": ["doctor"],
      "cwd": "${workspaceFolder}/core",
      "console": "integratedTerminal"
    },
    {
      "name": "Web (Chrome)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/web",
      "preLaunchTask": "web: dev"
    }
  ]
}
